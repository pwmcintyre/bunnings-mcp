{
  "name": "bunnings-mcp",
  "version": "0.1.0",
  "description": "Unofficial, read-only MCP server for the Bunnings Warehouse Australia website",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "LIVE=1 tsx --test test/live/*.test.ts",
    "refresh:fixtures": "tsx scripts/refresh-fixtures.ts",
    "build:stores": "tsx scripts/build-stores.ts",
    "eval:site": "tsx eval/run-site.ts",
    "eval": "tsx eval/score.ts",
    "find:store": "tsx scripts/find-store.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
